[
  {
    "id": "merge_m1",
    "patterns": [
      "(?:\\b(merge|juncao)\\b)|(?:\\b(?:juntar|juncao|junte|cruzar|cruzamento|unir|mesclar|validate)\\b)",
      "(?:muitos[ -]+para[ -]+um|\\bmany_to_one\\b|\\bm:1\\b)|(?:^(?!.*\\b(?:esquerda|direita)\\b).*?\\b(?:muitos|varios|multiplos)\\s+\\w+\\s+(?:para (?:um|uma)|por)\\s+\\w+|\\b(?:unica linha|chaves? unicas?)\\b.{0,36}\\bdireita\\b)|\\bdireita\\b.{0,32}\\b(?:chave unica|cadastro unico)\\b"
    ],
    "answer": "Use `validate=\"many_to_one\"` (ou `\"m:1\"`). As chaves do lado direito precisam ser únicas. A esquerda pode ter duplicatas. Por exemplo, em pedidos por cliente, essa orientação pressupõe pedidos à esquerda e cadastro único à direita.",
    "evidence": [
      {
        "id": "3a4cee70a1603446de850c88",
        "sha256": "a36b6a11b814bd4ccfd7c787866f72969d06ea6c01357cd751ad58c967cea821"
      }
    ]
  },
  {
    "id": "merge_1m",
